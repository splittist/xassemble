# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
XASSEMBLE_SECRET_KEY=replace-with-a-stable-random-secret-of-at-least-32-characters

# Public DNS name routed to this server. Caddy obtains and renews its TLS certificate.
XASSEMBLE_HOST=xassemble.example.com

# Optional; defaults to eight hours.
XASSEMBLE_SESSION_SECONDS=28800
